{
  "schema_version": 1,
  "provider": "azure",
  "rate": "-10%",
  "assets": [
    {
      "picture": 1,
      "number": 1,
      "speaker": "Benji",
      "english": "Look! The lake!",
      "audio_en": "audio/en/01_benji.mp3",
      "text": "Podívejte! Jezero!",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p01_01_benji.mp3",
      "sha256": "81902598fbcb1f23148f83e3a7f23b5f4307794f2da907724a4752ed1783dfe8",
      "bytes": 21888
    },
    {
      "picture": 1,
      "number": 2,
      "speaker": "Fiona",
      "english": "It’s beautiful. Look at the blue water.",
      "audio_en": "audio/en/02_fiona.mp3",
      "text": "Je krásné. Podívejte na tu modrou vodu.",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p01_02_fiona.mp3",
      "sha256": "6083379ca5ab8be0e1940955fdb25c35928ab587199752c9e23b198c5ee9be7f",
      "bytes": 30384
    },
    {
      "picture": 1,
      "number": 3,
      "speaker": "Sunny",
      "english": "And look at those clouds!",
      "audio_en": "audio/en/03_sunny.mp3",
      "text": "A podívejte na ty mraky!",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p01_03_sunny.mp3",
      "sha256": "86bb5ffdbc4e7be969a80f0e0207f19538edb16a9481116e03d77845e5c2e7b7",
      "bytes": 16560
    },
    {
      "picture": 1,
      "number": 4,
      "speaker": "Bunny",
      "english": "They look like my ears!",
      "audio_en": "audio/en/04_bunny.mp3",
      "text": "Vypadají jako moje uši!",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p01_04_bunny.mp3",
      "sha256": "fa8130276a95d600058190077d83180e0561a1ca8686db74b96f34ff1962d2ac",
      "bytes": 17280
    },
    {
      "picture": 1,
      "number": 5,
      "speaker": "Bruno",
      "english": "Two ears here. Two in the sky.",
      "audio_en": "audio/en/05_bruno.mp3",
      "text": "Dvě uši tady. Dvě na obloze.",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p01_05_bruno.mp3",
      "sha256": "b7032033d69ac16ae83c5268673c06b2791789a78b69103f294a5dc6e9e4fe37",
      "bytes": 26640
    },
    {
      "picture": 1,
      "number": 6,
      "speaker": "Sunny",
      "english": "Four ears! Can you hear us better?",
      "audio_en": "audio/en/06_sunny.mp3",
      "text": "Čtyři uši! Slyšíš nás teď lépe?",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p01_06_sunny.mp3",
      "sha256": "f2f9718c741c514282ffc7db35036b05c4572472bad89b9f053a769effac2b72",
      "bytes": 29088
    },
    {
      "picture": 1,
      "number": 7,
      "speaker": "Bunny",
      "english": "Yes. So please don’t shout!",
      "audio_en": "audio/en/07_bunny.mp3",
      "text": "Ano. Tak prosím nekřičte!",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p01_07_bunny.mp3",
      "sha256": "59056c0873dc6efcd0e59adbd10b689905a3c088444d3bd926d1812d8ad0b5fa",
      "bytes": 24336
    },
    {
      "picture": 2,
      "number": 1,
      "speaker": "Ollie",
      "english": "Look! A big fish in my net!",
      "audio_en": "audio/en/p02_01_ollie.mp3",
      "text": "Podívejte! Velká ryba v mém podběráku!",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p02_01_ollie.mp3",
      "sha256": "daa4d719a77c6f2f90c81fa4c2fb902186640cf1042c16a7919e567169d2c1fe",
      "bytes": 30816
    },
    {
      "picture": 2,
      "number": 2,
      "speaker": "Bruno",
      "english": "That’s a big dinner!",
      "audio_en": "audio/en/p02_02_bruno.mp3",
      "text": "To je pořádná večeře!",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p02_02_bruno.mp3",
      "sha256": "ddbded08b0a729ec3c357e7a001b16f82dc2f999b903fa5b00141a29aa973b19",
      "bytes": 16848
    },
    {
      "picture": 2,
      "number": 3,
      "speaker": "Ollie",
      "english": "Will you eat with me?",
      "audio_en": "audio/en/p02_03_ollie.mp3",
      "text": "Dáte si se mnou?",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p02_03_ollie.mp3",
      "sha256": "9c569a88f3124d86b93e12b3feb6339bfbd758da1396b8b797b1187b58037aa0",
      "bytes": 13968
    },
    {
      "picture": 2,
      "number": 4,
      "speaker": "Benji",
      "english": "Thank you, but we have our own food.",
      "audio_en": "audio/en/p02_04_benji.mp3",
      "text": "Děkujeme, ale máme vlastní jídlo.",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p02_04_benji.mp3",
      "sha256": "236dbc4457e7a8dfb4ba2e2f2c4a6c5512a1e03566a87ab3caf9947973de7102",
      "bytes": 23904
    },
    {
      "picture": 2,
      "number": 5,
      "speaker": "Fiona",
      "english": "We’re here for the meeting. Where is it?",
      "audio_en": "audio/en/p02_05_fiona.mp3",
      "text": "Přišli jsme na sněm. Kde bude?",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p02_05_fiona.mp3",
      "sha256": "842d2a94ddae5d5ed33a941351d18ea26eec8b63c884e216e62ac7048f7ddca5",
      "bytes": 25488
    },
    {
      "picture": 2,
      "number": 6,
      "speaker": "Ollie",
      "english": "On the other side of the lake, next morning.",
      "audio_en": "audio/en/p02_06_ollie.mp3",
      "text": "Na druhé straně jezera, zítra ráno.",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p02_06_ollie.mp3",
      "sha256": "be464adb8c2773336c494555280ec0a4a7dfecc39012d1a2cd1e49965c5e42bb",
      "bytes": 25632
    },
    {
      "picture": 2,
      "number": 7,
      "speaker": "Sunny",
      "english": "How will we find the place?",
      "audio_en": "audio/en/p02_07_sunny.mp3",
      "text": "Jak to místo najdeme?",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p02_07_sunny.mp3",
      "sha256": "c16423c5a362b55fc7ce3dcb9f91837907f1fa47cf1d0258bdd0f5913c5b76a2",
      "bytes": 15408
    },
    {
      "picture": 2,
      "number": 8,
      "speaker": "Ollie",
      "english": "Look for an old boat beside an old fishing hut.",
      "audio_en": "audio/en/p02_08_ollie.mp3",
      "text": "Hledejte starou loď vedle staré rybářské chatrče.",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p02_08_ollie.mp3",
      "sha256": "5c94e228945f037c7b219db7b899a4095d6eaee0153cbfe3bcc519f5c540b3f3",
      "bytes": 27648
    },
    {
      "picture": 2,
      "number": 9,
      "speaker": "Ollie",
      "english": "Follow the path by the water.",
      "audio_en": "audio/en/p02_09_ollie.mp3",
      "text": "Jděte po cestě podél vody.",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p02_09_ollie.mp3",
      "sha256": "d4338e07aec1c649e1ec04690334e62946b78b310dca000360bfaf67ed9e00f8",
      "bytes": 18000
    },
    {
      "picture": 2,
      "number": 10,
      "speaker": "Bunny",
      "english": "Thank you, Ollie. Enjoy your fish!",
      "audio_en": "audio/en/p02_10_bunny.mp3",
      "text": "Děkujeme, Ollie. Dobrou chuť!",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p02_10_bunny.mp3",
      "sha256": "ceee0a83cadf71518e491dc9271da293a7fc83ff0e30b924d3212667b4722308",
      "bytes": 27792
    },
    {
      "picture": 3,
      "number": 1,
      "speaker": "Dotty",
      "english": "A beautiful jump, Freddie!",
      "audio_en": "audio/en/p03_01_dotty.mp3",
      "text": "Krásný skok, Freddie!",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p03_01_dotty.mp3",
      "sha256": "771f30a16344e768f051ec13a7e51f5571603d4dfd9e72fc7af5f370bad18ea6",
      "bytes": 18288
    },
    {
      "picture": 3,
      "number": 2,
      "speaker": "Freddie",
      "english": "And a big splash!",
      "audio_en": "audio/en/p03_02_freddie.mp3",
      "text": "A pořádné šplouchnutí!",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p03_02_freddie.mp3",
      "sha256": "213494b12573ea0006a53abb53f27cff5efb91edcd22ab7881be1ca8a2709398",
      "bytes": 17424
    },
    {
      "picture": 3,
      "number": 3,
      "speaker": "Dotty",
      "english": "Too big! Try a smaller splash next time.",
      "audio_en": "audio/en/p03_03_dotty.mp3",
      "text": "Až moc velké! Příště zkus šplouchnout méně.",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p03_03_dotty.mp3",
      "sha256": "385f6c6eb6bb2947461bf5b922517237daa7355892624689140237e0aead9f35",
      "bytes": 32976
    },
    {
      "picture": 3,
      "number": 4,
      "speaker": "Bunny",
      "english": "Why are you practising?",
      "audio_en": "audio/en/p03_04_bunny.mp3",
      "text": "Proč trénuješ?",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p03_04_bunny.mp3",
      "sha256": "eba4edb6e0d28f9c580ff7ed15e37f4b25b329093f361f841f1d849595ee7a04",
      "bytes": 14256
    },
    {
      "picture": 3,
      "number": 5,
      "speaker": "Freddie",
      "english": "For the frog-jumping race!",
      "audio_en": "audio/en/p03_05_freddie.mp3",
      "text": "Na závod ve skoku žabáků!",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p03_05_freddie.mp3",
      "sha256": "42fa4d40fee56accfc1872f58da83f400e9a0193498240069032327ccd01f97d",
      "bytes": 19728
    },
    {
      "picture": 3,
      "number": 6,
      "speaker": "Fiona",
      "english": "We’re here for the meeting.",
      "audio_en": "audio/en/p03_06_fiona.mp3",
      "text": "Přišli jsme na sněm.",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p03_06_fiona.mp3",
      "sha256": "0940fa87a6be58d2bac039aff17bc9013ea6fe79ca167a1e66a53fe6eac60f97",
      "bytes": 15552
    },
    {
      "picture": 3,
      "number": 7,
      "speaker": "Dotty",
      "english": "We’re coming too. See you there!",
      "audio_en": "audio/en/p03_07_dotty.mp3",
      "text": "My přijdeme také. Uvidíme se tam!",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p03_07_dotty.mp3",
      "sha256": "0593e69f5718cbe1782c95708477f2e77682fb289679ec3964cd18a160688f3c",
      "bytes": 28800
    },
    {
      "picture": 3,
      "number": 8,
      "speaker": "Freddie",
      "english": "Just one more jump!",
      "audio_en": "audio/en/p03_08_freddie.mp3",
      "text": "Ještě jeden skok!",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p03_08_freddie.mp3",
      "sha256": "cad0c781b7a5582c755041525a858da1b2869b9b4e08fd1d7aaca7c38c3d73fe",
      "bytes": 14976
    },
    {
      "picture": 4,
      "number": 1,
      "speaker": "Benji",
      "english": "There’s the boat. And the old hut.",
      "audio_en": "audio/en/p04_01_benji.mp3",
      "text": "Tamhle je ta loď. A stará chatrč.",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p04_01_benji.mp3",
      "sha256": "4f6f809403d5a1db4f2084d0ef58acb1e55566f0159d6155a82d16d2ec99408e",
      "bytes": 27504
    },
    {
      "picture": 4,
      "number": 2,
      "speaker": "Fiona",
      "english": "No one is here yet.",
      "audio_en": "audio/en/p04_02_fiona.mp3",
      "text": "Ještě tu nikdo není.",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p04_02_fiona.mp3",
      "sha256": "8f2b59906bc3fbef688ff8efd5a6578e0ede619d73f7c0102553f28bed4b6eaf",
      "bytes": 15984
    },
    {
      "picture": 4,
      "number": 3,
      "speaker": "Sunny",
      "english": "The hut is empty too.",
      "audio_en": "audio/en/p04_03_sunny.mp3",
      "text": "I chatrč je prázdná.",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p04_03_sunny.mp3",
      "sha256": "1683abb7cfe7aed54a8adbdb952560324a958235c7ee4f47a28d388046b88ed9",
      "bytes": 16416
    },
    {
      "picture": 4,
      "number": 4,
      "speaker": "Bruno",
      "english": "It’s old, but it’s dry inside.",
      "audio_en": "audio/en/p04_04_bruno.mp3",
      "text": "Je stará, ale uvnitř je sucho.",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p04_04_bruno.mp3",
      "sha256": "53e1891676c6b727adf2d38f2011b647adcf6bcc1a77bec24e62cf065e1e107a",
      "bytes": 22608
    },
    {
      "picture": 4,
      "number": 5,
      "speaker": "Benji",
      "english": "We can sleep here tonight.",
      "audio_en": "audio/en/p04_05_benji.mp3",
      "text": "Dnes v noci tu můžeme přespat.",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p04_05_benji.mp3",
      "sha256": "b1b6e8b33634540cf206d801d9f2198be94f654aeb6e75fb006c33cc7d9b7690",
      "bytes": 19296
    },
    {
      "picture": 4,
      "number": 6,
      "speaker": "Bunny",
      "english": "Can we eat here too?",
      "audio_en": "audio/en/p04_06_bunny.mp3",
      "text": "A můžeme se tu také najíst?",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p04_06_bunny.mp3",
      "sha256": "91f3aab48e5141b24357a7787d808ac70046cb742349ca8e31a7b8a9a6e3d162",
      "bytes": 18720
    },
    {
      "picture": 4,
      "number": 7,
      "speaker": "Fiona",
      "english": "Yes. Let’s eat before the meeting.",
      "audio_en": "audio/en/p04_07_fiona.mp3",
      "text": "Ano. Najezme se před sněmem.",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p04_07_fiona.mp3",
      "sha256": "eabdc67d3d8d4fd7e6561c1e442c91cca4e8211155ab2291a2495db863120883",
      "bytes": 26208
    },
    {
      "picture": 5,
      "number": 1,
      "speaker": "Bunny",
      "english": "Good food and a warm fire. I like it here.",
      "audio_en": "audio/en/p05_01_bunny.mp3",
      "text": "Dobré jídlo a teplý oheň. Líbí se mi tu.",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p05_01_bunny.mp3",
      "sha256": "e6292aae2b60bc15c4c935e72ea84886c517830bfef0fe6053a1e003c02e6d4f",
      "bytes": 33120
    },
    {
      "picture": 5,
      "number": 2,
      "speaker": "Fiona",
      "english": "But why did the old stag call us here?",
      "audio_en": "audio/en/p05_02_fiona.mp3",
      "text": "Ale proč nás sem starý jelen svolal?",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p05_02_fiona.mp3",
      "sha256": "c964dce53ba17a646351b02391cfa37e6b15964c7d9e4fcc4b4134fbaa13a37c",
      "bytes": 22176
    },
    {
      "picture": 5,
      "number": 3,
      "speaker": "Sunny",
      "english": "Maybe he wants a party.",
      "audio_en": "audio/en/p05_03_sunny.mp3",
      "text": "Možná chce uspořádat oslavu.",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p05_03_sunny.mp3",
      "sha256": "d457c8fd046d2c03a03ce365c4adb3c968ab104be9409f0f1e64306b0d7374dd",
      "bytes": 20592
    },
    {
      "picture": 5,
      "number": 4,
      "speaker": "Bunny",
      "english": "Then we can bring some food!",
      "audio_en": "audio/en/p05_04_bunny.mp3",
      "text": "Tak můžeme přinést něco k jídlu!",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p05_04_bunny.mp3",
      "sha256": "83bbc58e0550825e2c97500e58f5f6be2200cf061982ded92c37f6b4c617b7f2",
      "bytes": 20304
    },
    {
      "picture": 5,
      "number": 5,
      "speaker": "Bruno",
      "english": "He asked every animal to come. Maybe he needs help.",
      "audio_en": "audio/en/p05_05_bruno.mp3",
      "text": "Požádal všechna zvířata, aby přišla. Možná potřebuje pomoc.",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p05_05_bruno.mp3",
      "sha256": "709c8267a94583ef500d15f91467d0c1aef2c1c1d83d200cb2f84d020db31192",
      "bytes": 41472
    },
    {
      "picture": 5,
      "number": 6,
      "speaker": "Fiona",
      "english": "Do you think something is wrong?",
      "audio_en": "audio/en/p05_06_fiona.mp3",
      "text": "Myslíš, že se něco děje?",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p05_06_fiona.mp3",
      "sha256": "a2808e2684313ba13d3fbb5e932998b92c2e5145e2b329bf0a0e0b457ebe77ff",
      "bytes": 17424
    },
    {
      "picture": 5,
      "number": 7,
      "speaker": "Benji",
      "english": "Let’s eat. We’ll soon find out.",
      "audio_en": "audio/en/p05_07_benji.mp3",
      "text": "Najezme se. Brzy to zjistíme.",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p05_07_benji.mp3",
      "sha256": "6cf45777a20d1ff728e2926038fdb313a0e453524bac5cb76085d350df6dae25",
      "bytes": 26496
    },
    {
      "picture": 6,
      "number": 1,
      "speaker": "Old Stag",
      "english": "You all want to know why I called you here.",
      "audio_en": "audio/en/p06_01_old_stag.mp3",
      "text": "Všichni chcete vědět, proč jsem vás sem svolal.",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p06_01_old_stag.mp3",
      "sha256": "b94253ce03312d4191db79e9022450d2fcf6e6fb84ccf52a53bd39f144ff9f5b",
      "bytes": 28656
    },
    {
      "picture": 6,
      "number": 2,
      "speaker": "Animals",
      "english": "Yes! Yes! Tell us!",
      "audio_en": "audio/en/p06_02_animals.mp3",
      "text": "Ano! Ano! Pověz nám to!",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p06_02_animals.mp3",
      "sha256": "05338d9d1e4b98043d685f98bea8e621eb71825a2fafd2cbd6e81c29edcaa562",
      "bytes": 30240
    },
    {
      "picture": 6,
      "number": 3,
      "speaker": "Old Stag",
      "english": "Our forest is old. Many trees are sick.",
      "audio_en": "audio/en/p06_03_old_stag.mp3",
      "text": "Náš les je starý. Mnoho stromů je nemocných.",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p06_03_old_stag.mp3",
      "sha256": "3e0dfcef8d3ba963677a211aaf37786ac292cf69c905ef2d6717d7365d24e232",
      "bytes": 33552
    },
    {
      "picture": 6,
      "number": 4,
      "speaker": "Fiona",
      "english": "Can we help them?",
      "audio_en": "audio/en/p06_04_fiona.mp3",
      "text": "Můžeme jim pomoci?",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p06_04_fiona.mp3",
      "sha256": "e50e9eb6ad450592e687de52e4181b403a4bee5e0420ab51ac7c465a216b2792",
      "bytes": 14544
    },
    {
      "picture": 6,
      "number": 5,
      "speaker": "Old Stag",
      "english": "People may come and cut down the whole forest.",
      "audio_en": "audio/en/p06_05_old_stag.mp3",
      "text": "Možná přijdou lidé a pokácejí celý les.",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p06_05_old_stag.mp3",
      "sha256": "4b8c245a7ea8c95bfde31cef800c42a99aba3d473ac545b589a1d89ffa0fd6d9",
      "bytes": 27360
    },
    {
      "picture": 6,
      "number": 6,
      "speaker": "Bunny",
      "english": "Even the healthy trees?",
      "audio_en": "audio/en/p06_06_bunny.mp3",
      "text": "I zdravé stromy?",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p06_06_bunny.mp3",
      "sha256": "c83c25ce4030aadc0fca6e18a88bf596ab584c23b6b61e0942bcc9f1673a7e49",
      "bytes": 13392
    },
    {
      "picture": 6,
      "number": 7,
      "speaker": "Old Stag",
      "english": "Yes. We need to save our home.",
      "audio_en": "audio/en/p06_07_old_stag.mp3",
      "text": "Ano. Musíme zachránit náš domov.",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p06_07_old_stag.mp3",
      "sha256": "d162f0f17bbdc6c6e013ea71ddd67760b6537019c68a2c86d64d938f00040d34",
      "bytes": 28800
    },
    {
      "picture": 6,
      "number": 8,
      "speaker": "Old Stag",
      "english": "Does anyone have an idea?",
      "audio_en": "audio/en/p06_08_old_stag.mp3",
      "text": "Má někdo nějaký nápad?",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p06_08_old_stag.mp3",
      "sha256": "781954b55adbf2fb0a103d7c4c3efd5b31afc163d2b608f1747bac27921825eb",
      "bytes": 17424
    },
    {
      "picture": 7,
      "number": 1,
      "speaker": "Logan",
      "english": "I do. The woodpecker can find the sick trees.",
      "audio_en": "audio/en/p07_01_logan.mp3",
      "text": "Já ano. Datel může najít nemocné stromy.",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p07_01_logan.mp3",
      "sha256": "c0f335c9de8e1c8c88aef419dbd60135ec44a32e9476cd3b0cd241197cf00a08",
      "bytes": 32112
    },
    {
      "picture": 7,
      "number": 2,
      "speaker": "Woodpecker",
      "english": "I can check every tree.",
      "audio_en": "audio/en/p07_02_woodpecker.mp3",
      "text": "Mohu prohlédnout každý strom.",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p07_02_woodpecker.mp3",
      "sha256": "d65b9be52181269f826207f55e368f67b952af24932b71162a1cda0f74013763",
      "bytes": 20304
    },
    {
      "picture": 7,
      "number": 3,
      "speaker": "Logan",
      "english": "Then my beaver friends and I can cut the sick ones down.",
      "audio_en": "audio/en/p07_03_logan.mp3",
      "text": "Pak moji bobří přátelé a já můžeme ty nemocné pokácet.",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p07_03_logan.mp3",
      "sha256": "fd2d3050d672d091154523bdd7f554aab33510d380bf665640bc6c7bf39cf5d8",
      "bytes": 32400
    },
    {
      "picture": 7,
      "number": 4,
      "speaker": "Fiona",
      "english": "And leave the healthy trees?",
      "audio_en": "audio/en/p07_04_fiona.mp3",
      "text": "A zdravé stromy nechat stát?",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p07_04_fiona.mp3",
      "sha256": "19b655ff8c3479ef5bba4e93c0bc3ebbc8bfff09d1b803d52a68442791a0ebc3",
      "bytes": 18432
    },
    {
      "picture": 7,
      "number": 5,
      "speaker": "Logan",
      "english": "Yes. But we need help. Those trees are heavy.",
      "audio_en": "audio/en/p07_05_logan.mp3",
      "text": "Ano. Ale potřebujeme pomoc. Ty stromy jsou těžké.",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p07_05_logan.mp3",
      "sha256": "6836b5a6ae258b3bb208956fadedfc08db9e5ddb57546c5d8cb4a8e52d543fae",
      "bytes": 40608
    },
    {
      "picture": 7,
      "number": 6,
      "speaker": "Bruno",
      "english": "Where must we take them?",
      "audio_en": "audio/en/p07_06_bruno.mp3",
      "text": "Kam je musíme dopravit?",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p07_06_bruno.mp3",
      "sha256": "0cb0d1ee487af65a8aba2225669ab1bc45f9b01ca2b1297d6e94e0303b138ee6",
      "bytes": 16992
    },
    {
      "picture": 7,
      "number": 7,
      "speaker": "Logan",
      "english": "Here, to the shore. People can find them here and take them away.",
      "audio_en": "audio/en/p07_07_logan.mp3",
      "text": "Sem, na břeh. Tady je lidé mohou najít a odvézt.",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p07_07_logan.mp3",
      "sha256": "012614b8d38dc1358b8d2d9fca89ef4e557eed83d3e8a368fc5235e94a92bc65",
      "bytes": 38880
    },
    {
      "picture": 7,
      "number": 8,
      "speaker": "Old Stag",
      "english": "Who will help the beavers?",
      "audio_en": "audio/en/p07_08_old_stag.mp3",
      "text": "Kdo pomůže bobrům?",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p07_08_old_stag.mp3",
      "sha256": "a4aca10b1ad32fe2f31a8498056de2aa970244e8557c380276f9c5a2672e2920",
      "bytes": 15264
    },
    {
      "picture": 8,
      "number": 1,
      "speaker": "Animals",
      "english": "Me! Me! I’ll help!",
      "audio_en": "audio/en/p08_01_animals.mp3",
      "text": "Já! Já! Já pomůžu!",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p08_01_animals.mp3",
      "sha256": "aebe344a25fb95acc7a4128b7edd84021d6b17e35cbc5fd33a35730915e39f12",
      "bytes": 28800
    },
    {
      "picture": 8,
      "number": 2,
      "speaker": "Freddie",
      "english": "Me too!",
      "audio_en": "audio/en/p08_02_freddie.mp3",
      "text": "Já také!",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p08_02_freddie.mp3",
      "sha256": "cc047a66d8b92b2d05076835d15d7ee45c4b94a8c39894cece019f87b13f0d85",
      "bytes": 11664
    },
    {
      "picture": 8,
      "number": 3,
      "speaker": "Dotty",
      "english": "And me!",
      "audio_en": "audio/en/p08_03_dotty.mp3",
      "text": "A já!",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p08_03_dotty.mp3",
      "sha256": "4e0fa6e6189b016bb0e1d95e7fb5d61f5af1f5482aac4a289d606ea4b6563485",
      "bytes": 11232
    },
    {
      "picture": 8,
      "number": 4,
      "speaker": "Ollie",
      "english": "We can all do something.",
      "audio_en": "audio/en/p08_04_ollie.mp3",
      "text": "Každý z nás může něco udělat.",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p08_04_ollie.mp3",
      "sha256": "a5323058ea6e9ab8b083e5c72191c9dad3a876c3c6d2176d7da479b68da7bab7",
      "bytes": 20880
    },
    {
      "picture": 8,
      "number": 5,
      "speaker": "Old Stag",
      "english": "Good. But this will be hard work for everyone.",
      "audio_en": "audio/en/p08_05_old_stag.mp3",
      "text": "Dobře. Ale bude to těžká práce pro všechny.",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p08_05_old_stag.mp3",
      "sha256": "fc994528d5aaa86c6b95e9eb13b4cf0a9f96684621a7dff8c1fa892e42747a8b",
      "bytes": 31248
    },
    {
      "picture": 8,
      "number": 6,
      "speaker": "Old Stag",
      "english": "Who will lead our team?",
      "audio_en": "audio/en/p08_06_old_stag.mp3",
      "text": "Kdo povede náš tým?",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p08_06_old_stag.mp3",
      "sha256": "63e07931d43501c7fc55857154bd448d7a34e0eeb837a25f2f57ccc45881023c",
      "bytes": 15552
    },
    {
      "picture": 10,
      "number": 1,
      "speaker": "Benji",
      "english": "I will. I have a plan.",
      "audio_en": "audio/en/p10_01_benji.mp3",
      "text": "Já. Mám plán.",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p10_01_benji.mp3",
      "sha256": "8e6cead4028cacce5bf2fd8fdfc3f925fa1e6af5341d7be6988fd1a1458bedbc",
      "bytes": 20736
    },
    {
      "picture": 10,
      "number": 2,
      "speaker": "Old Stag",
      "english": "Tell us, Benji.",
      "audio_en": "audio/en/p10_02_old_stag.mp3",
      "text": "Pověz nám ho, Benji.",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p10_02_old_stag.mp3",
      "sha256": "7b98052619fd6d301e2ab1dd7359ddf662f97d3a8a2ad49cf7d702b51177c32b",
      "bytes": 18432
    },
    {
      "picture": 10,
      "number": 3,
      "speaker": "Benji",
      "english": "I have a map of the forest.",
      "audio_en": "audio/en/p10_03_benji.mp3",
      "text": "Mám mapu lesa.",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p10_03_benji.mp3",
      "sha256": "a9c5fcafca5cbd04ff3af08bad46ed682925ec5dddea9ee5b88ac5152da69c8c",
      "bytes": 13680
    },
    {
      "picture": 10,
      "number": 4,
      "speaker": "Benji",
      "english": "I’ll show you where to start and what to do.",
      "audio_en": "audio/en/p10_04_benji.mp3",
      "text": "Ukážu vám, kde začít a co dělat.",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p10_04_benji.mp3",
      "sha256": "7ded4c1740ae7579c61584821165ddf9a00dfc7057cc809d9dbf6b20672b5a9e",
      "bytes": 24768
    },
    {
      "picture": 10,
      "number": 5,
      "speaker": "Benji",
      "english": "We can do this together.",
      "audio_en": "audio/en/p10_05_benji.mp3",
      "text": "Společně to zvládneme.",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p10_05_benji.mp3",
      "sha256": "6e5ea5930feccc231c8af9fa3adc1cb6cd60be21e41967fbd551ce02611aefe2",
      "bytes": 16416
    },
    {
      "picture": 10,
      "number": 6,
      "speaker": "Animals",
      "english": "Yes! Great! Thank you, Benji!",
      "audio_en": "audio/en/p10_06_animals.mp3",
      "text": "Ano! Výborně! Děkujeme, Benji!",
      "voice": "cs-CZ-VlastaNeural",
      "audio": "audio/cs/p10_06_animals.mp3",
      "sha256": "a3027a3cd034c568b42d5927fde9aed701bb57e798e78c2372e362b102381383",
      "bytes": 36000
    }
  ]
}
