{
  "openapi": "3.1.0",
  "info": {
    "title": "Camino metadata contract",
    "version": "1.0.0",
    "description": "C03b owner-only metadata subset. C05 supplies the private HTTPS listener and production authentication. Media upload, pairing, backup, and Viewer routes are separate stages."
  },
  "servers": [],
  "security": [{ "ownerBearer": [] }],
  "paths": {
    "/api/v1/state": {
      "get": {
        "operationId": "readServerState",
        "summary": "Read server identity, epoch, contiguous cursor, and export block",
        "responses": {
          "200": { "description": "Owner-only state", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ServerState" } } } },
          "401": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/operations": {
      "post": {
        "operationId": "appendOperation",
        "summary": "Append one contiguous, idempotent metadata operation",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationEnvelope" } } } },
        "responses": {
          "200": { "description": "Durable operation receipt, including an exact retry", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Receipt" } } } },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "415": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" },
          "426": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/changes": {
      "get": {
        "operationId": "readChanges",
        "summary": "Read owner changes after a contiguous cursor in the current epoch",
        "parameters": [
          { "name": "epoch", "in": "query", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "cursor", "in": "query", "required": true, "schema": { "type": "integer", "minimum": 0 } }
        ],
        "responses": {
          "200": { "description": "At most 100 accepted operations and next cursor", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChangePage" } } } },
          "401": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/moments/{moment_id}": {
      "get": {
        "operationId": "readMoment",
        "summary": "Read current owner Moment metadata",
        "parameters": [{ "$ref": "#/components/parameters/MomentId" }],
        "responses": {
          "200": { "description": "Current accepted Moment", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MomentResponse" } } } },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/moments/{moment_id}/text": {
      "get": {
        "operationId": "readTextRevisions",
        "summary": "Read owner text revision history; drafts are never included",
        "parameters": [{ "$ref": "#/components/parameters/MomentId" }],
        "responses": {
          "200": { "description": "Accepted text revisions", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TextHistoryResponse" } } } },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/reconcile": {
      "post": {
        "operationId": "compareRestoredInventory",
        "summary": "Compare owner Moment inventory after an epoch rotation; never unblocks exports",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReconcileRequest" } } } },
        "responses": {
          "200": { "description": "Differences only; no automatic deletion or unlock", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReconcileResponse" } } } },
          "401": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "415": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" },
          "426": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ownerBearer": { "type": "http", "scheme": "bearer", "description": "C05 must validate a revocable owner token; the C03b adapter requires an injected authenticator." }
    },
    "parameters": {
      "MomentId": { "name": "moment_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
    },
    "responses": {
      "Error": { "description": "Stable machine code without private payload or stack trace", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
    },
    "schemas": {
      "ServerState": {
        "type": "object", "additionalProperties": false,
        "required": ["contract_version", "server_id", "epoch", "cursor", "writer_device_id", "exports_blocked", "reconciliation_required"],
        "properties": {
          "contract_version": { "const": 1 }, "server_id": { "type": "string", "format": "uuid" },
          "features": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "epoch": { "type": "string", "format": "uuid" }, "cursor": { "type": "integer", "minimum": 0 },
          "writer_device_id": { "oneOf": [{ "type": "string", "format": "uuid" }, { "type": "null" }] },
          "exports_blocked": { "type": "boolean" }, "reconciliation_required": { "type": "boolean" }
        }
      },
      "OperationEnvelope": {
        "type": "object", "additionalProperties": false,
        "required": ["contract_version", "epoch", "operation_id", "device_id", "device_sequence", "kind", "expected_revision", "payload"],
        "properties": {
          "contract_version": { "const": 1 }, "epoch": { "type": "string", "format": "uuid" },
          "operation_id": { "type": "string", "format": "uuid" },
          "device_id": { "type": "string", "format": "uuid" },
          "device_sequence": { "type": "integer", "minimum": 1 },
          "kind": { "enum": ["create_trip", "create_day", "create_moment", "create_asset", "update_metadata", "append_text", "create_audio_layout"] },
          "expected_revision": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
          "payload": { "type": "object" }
        },
        "allOf": [
          { "if": { "properties": { "kind": { "const": "create_trip" } } }, "then": { "properties": { "expected_revision": { "type": "null" }, "payload": { "$ref": "#/components/schemas/Trip" } } } },
          { "if": { "properties": { "kind": { "const": "create_day" } } }, "then": { "properties": { "expected_revision": { "type": "null" }, "payload": { "$ref": "#/components/schemas/JourneyDay" } } } },
          { "if": { "properties": { "kind": { "const": "create_moment" } } }, "then": { "properties": { "expected_revision": { "type": "null" }, "payload": { "allOf": [{ "$ref": "#/components/schemas/Moment" }, { "properties": { "revision": { "const": 1 } } }] } } } },
          { "if": { "properties": { "kind": { "const": "create_asset" } } }, "then": { "properties": { "expected_revision": { "type": "null" }, "payload": { "$ref": "#/components/schemas/Asset" } } } },
          { "if": { "properties": { "kind": { "const": "create_audio_layout" } } }, "then": { "properties": { "expected_revision": { "type": "null" }, "payload": { "$ref": "#/components/schemas/AudioLayout" } } } },
          { "if": { "properties": { "kind": { "const": "update_metadata" } } }, "then": { "properties": { "expected_revision": { "type": "integer", "minimum": 1 }, "payload": { "$ref": "#/components/schemas/MetadataPayload" } } } },
          { "if": { "properties": { "kind": { "const": "append_text" } } }, "then": { "properties": { "expected_revision": { "type": "integer", "minimum": 1 }, "payload": { "$ref": "#/components/schemas/TextRevision" } } } }
        ]
      },
      "AudioLayout": {
        "type": "object", "additionalProperties": false,
        "required": ["clip_id", "moment_id", "session_id", "previous_clip_id", "gap_before_ms", "missing_tail", "parts"],
        "properties": {
          "clip_id": { "type": "string", "format": "uuid" },
          "moment_id": { "type": "string", "format": "uuid" },
          "session_id": { "type": "string", "format": "uuid" },
          "previous_clip_id": { "oneOf": [{ "type": "string", "format": "uuid" }, { "type": "null" }] },
          "gap_before_ms": { "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, { "type": "null" }] },
          "missing_tail": { "type": "boolean" },
          "parts": {
            "type": "array", "minItems": 1, "maxItems": 4096,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["asset_id", "index", "discontinuity_before"],
              "properties": {
                "asset_id": { "type": "string", "format": "uuid" },
                "index": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
                "discontinuity_before": { "type": "boolean" }
              }
            }
          }
        }
      },
      "Trip": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "language", "active", "viewer_enabled", "start_date"],
        "properties": {
          "id": { "type": "string", "format": "uuid" }, "name": { "type": "string", "minLength": 1 },
          "language": { "type": "string", "minLength": 1 }, "active": { "type": "boolean" },
          "viewer_enabled": { "type": "boolean" },
          "start_date": { "oneOf": [{ "type": "string", "format": "date" }, { "type": "null" }] }
        }
      },
      "JourneyDay": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "trip_id", "local_date"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "trip_id": { "type": "string", "format": "uuid" },
          "local_date": { "type": "string", "format": "date" }
        }
      },
      "CaptureTime": {
        "type": "object", "additionalProperties": false,
        "required": ["utc_ms", "local_wall", "utc_offset_minutes", "time_zone_id", "source", "uncertain"],
        "properties": {
          "utc_ms": { "oneOf": [{ "type": "integer" }, { "type": "null" }] },
          "local_wall": { "oneOf": [{ "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$" }, { "type": "null" }] },
          "utc_offset_minutes": { "oneOf": [{ "type": "integer", "minimum": -840, "maximum": 840 }, { "type": "null" }] },
          "time_zone_id": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
          "source": { "enum": ["device_capture", "import_metadata", "import_assignment"] },
          "uncertain": { "type": "boolean" }
        }
      },
      "LocationFix": {
        "type": "object", "additionalProperties": false,
        "required": ["latitude", "longitude", "measured_at_utc_ms", "horizontal_accuracy_m"],
        "properties": {
          "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
          "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
          "measured_at_utc_ms": { "type": "integer" },
          "horizontal_accuracy_m": { "type": "number", "minimum": 0 }
        }
      },
      "Moment": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "trip_id", "day_id", "chapter_date", "kind", "captured", "privacy", "revision", "hidden", "important", "related_moment_id", "location"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "trip_id": { "type": "string", "format": "uuid" },
          "day_id": { "type": "string", "format": "uuid" },
          "chapter_date": { "type": "string", "format": "date" },
          "kind": { "enum": ["photo", "video", "comment", "reflection", "marker"] },
          "captured": { "$ref": "#/components/schemas/CaptureTime" },
          "privacy": { "enum": ["owner_only", "diary"] },
          "revision": { "type": "integer", "minimum": 1 },
          "hidden": { "type": "boolean" }, "important": { "type": "boolean" },
          "related_moment_id": { "oneOf": [{ "type": "string", "format": "uuid" }, { "type": "null" }] },
          "location": { "oneOf": [{ "$ref": "#/components/schemas/LocationFix" }, { "type": "null" }] }
        }
      },
      "Asset": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "moment_id", "media_kind", "origin", "byte_count", "sha256", "duration_ms"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "moment_id": { "type": "string", "format": "uuid" },
          "media_kind": { "enum": ["photo", "video", "audio"] },
          "origin": { "enum": ["camera", "recording", "photo_picker", "file_import"] },
          "byte_count": { "type": "integer", "minimum": 0 },
          "sha256": { "oneOf": [{ "type": "string", "pattern": "^[0-9a-f]{64}$" }, { "type": "null" }] },
          "duration_ms": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] }
        }
      },
      "TextRevision": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "moment_id", "role", "content", "source_ids", "parent_revision_id", "created_at_utc_ms"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "moment_id": { "type": "string", "format": "uuid" },
          "role": { "enum": ["typed_source", "transcript_raw", "transcript_clean", "human_revision"] },
          "content": { "type": "string" },
          "source_ids": { "type": "array", "items": { "type": "string", "format": "uuid" } },
          "parent_revision_id": { "oneOf": [{ "type": "string", "format": "uuid" }, { "type": "null" }] },
          "created_at_utc_ms": { "type": "integer" }
        }
      },
      "MetadataPayload": {
        "type": "object", "additionalProperties": false,
        "required": ["moment_id", "change"],
        "properties": {
          "moment_id": { "type": "string", "format": "uuid" },
          "change": { "oneOf": [
            { "$ref": "#/components/schemas/PrivacyChange" },
            { "$ref": "#/components/schemas/HiddenChange" },
            { "$ref": "#/components/schemas/ChapterChange" }
          ] }
        }
      },
      "PrivacyChange": {
        "type": "object", "additionalProperties": false,
        "required": ["type", "new_privacy", "user_action"],
        "properties": {
          "type": { "const": "privacy" }, "new_privacy": { "enum": ["owner_only", "diary"] },
          "user_action": { "enum": ["lock", "unlock", "insert_reflection_into_diary"] }
        }
      },
      "HiddenChange": {
        "type": "object", "additionalProperties": false,
        "required": ["type", "hidden"],
        "properties": { "type": { "const": "hidden" }, "hidden": { "type": "boolean" } }
      },
      "ChapterChange": {
        "type": "object", "additionalProperties": false,
        "required": ["type", "day_id"],
        "properties": {
          "type": { "const": "chapter" }, "day_id": { "type": "string", "format": "uuid" }
        }
      },
      "Receipt": {
        "type": "object", "additionalProperties": false,
        "required": ["contract_version", "server_id", "epoch", "cursor", "operation_id", "kind", "object_id", "revision", "reused"],
        "properties": {
          "contract_version": { "const": 1 }, "server_id": { "type": "string", "format": "uuid" },
          "epoch": { "type": "string", "format": "uuid" }, "cursor": { "type": "integer", "minimum": 1 },
          "operation_id": { "type": "string", "format": "uuid" }, "kind": { "type": "string" },
          "object_id": { "type": "string", "format": "uuid" },
          "revision": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
          "reused": { "type": "boolean" }
        }
      },
      "ChangePage": {
        "type": "object", "additionalProperties": false,
        "required": ["contract_version", "epoch", "cursor", "events", "reconciliation_required", "exports_blocked"],
        "properties": {
          "contract_version": { "const": 1 }, "epoch": { "type": "string", "format": "uuid" },
          "cursor": { "type": "integer", "minimum": 0 },
          "events": { "type": "array", "items": { "$ref": "#/components/schemas/OperationEnvelope" } },
          "reconciliation_required": { "type": "boolean" }, "exports_blocked": { "type": "boolean" }
        }
      },
      "MomentResponse": {
        "type": "object", "additionalProperties": false,
        "required": ["contract_version", "epoch", "moment"],
        "properties": {
          "contract_version": { "const": 1 }, "epoch": { "type": "string", "format": "uuid" },
          "moment": { "$ref": "#/components/schemas/Moment" }
        }
      },
      "TextHistoryResponse": {
        "type": "object", "additionalProperties": false,
        "required": ["contract_version", "moment_id", "revisions"],
        "properties": {
          "contract_version": { "const": 1 }, "moment_id": { "type": "string", "format": "uuid" },
          "revisions": { "type": "array", "items": { "$ref": "#/components/schemas/TextRevision" } }
        }
      },
      "ReconcileRequest": {
        "type": "object", "additionalProperties": false,
        "required": ["contract_version", "last_known_epoch", "moments"],
        "properties": {
          "contract_version": { "const": 1 }, "last_known_epoch": { "type": "string", "format": "uuid" },
          "moments": { "type": "array", "items": { "$ref": "#/components/schemas/InventoryMoment" } }
        }
      },
      "InventoryMoment": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "revision", "privacy"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "revision": { "type": "integer", "minimum": 1 },
          "privacy": { "type": "string", "description": "Unknown privacy remains fail-closed" }
        }
      },
      "ReconcileResponse": {
        "type": "object", "additionalProperties": false,
        "required": ["contract_version", "epoch", "differences", "exports_blocked", "reconciliation_required"],
        "properties": {
          "contract_version": { "const": 1 }, "epoch": { "type": "string", "format": "uuid" },
          "differences": { "type": "array", "items": { "type": "object", "required": ["id", "reason"], "properties": { "id": { "type": "string", "format": "uuid" }, "reason": { "enum": ["missing_on_server", "server_older", "state_differs", "missing_on_phone"] } } } },
          "exports_blocked": { "type": "boolean" }, "reconciliation_required": { "type": "boolean" }
        }
      },
      "ErrorResponse": {
        "type": "object", "additionalProperties": false, "required": ["contract_version", "error"],
        "properties": {
          "contract_version": { "const": 1 },
          "error": { "type": "object", "required": ["code", "message"], "properties": {
            "code": { "type": "string" }, "message": { "type": "string" },
            "current_revision": { "type": "integer", "minimum": 1 }
          } }
        }
      }
    }
  }
}
